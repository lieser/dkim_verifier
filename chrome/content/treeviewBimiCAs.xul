<?xml version="1.0"?>
<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>

<!DOCTYPE overlay SYSTEM "chrome://dkim_verifier/locale/xulstrings.dtd">

<window
	xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
	id="dkim_verifier-treeviewBimiCAs"
	windowtype="dkim_verifier:treeviewBimiCAs"
	title="&treeviewBimiCAs.title;"
	drawtitle="true"
	height="300"
	width="900"
	persist="width height screenX screenY sizemode"
	onload="setView();">

<script type="application/javascript" src="chrome://dkim_verifier/content/treeviewBimiCAs.js"/>

<tree id="my-tree" editable="false" enableColumnDrag="false" flex="1" onselect="changeSelection()">
	<treecols>
		<treecol id="commonName" editable="false" label="&treeviewBimiCAs.treecol.name.label;" flex="10"/>
		<splitter class="tree-splitter" />
		<treecol id="fingerprint" editable="false" label="&treeviewBimiCAs.treecol.fingerprint.label;" flex="20"/>
		<splitter class="tree-splitter" />
		<treecol id="expiresOn" editable="false" label="&treeviewBimiCAs.treecol.expire.label;" flex="2"/>
		<splitter class="tree-splitter" />
		<treecol id="trusted" editable="false" label="&treeviewBimiCAs.treecol.trust.label;" flex="1"/>
		<splitter class="tree-splitter" />
		<treecol id="internal" editable="false" label="&treeviewBimiCAs.treecol.internal.label;" flex="1"/>
		<splitter class="tree-splitter" />
	</treecols>
	<treechildren/>
</tree>

<hbox>
	<button label="&button.addCA.label;"
	        oncommand="addBimiCA()"/>
	<button id="removeCABtn"
			label="&button.removeCA.label;"
	        oncommand="removeBimiCA()"
			disabled="true"/>
	<button id="setCATrustBtn"
			label="&button.trustCA.label;"
	        oncommand="setBimiCATrust()"
			disabled="true"/>
	<button id="viewDetailsBtn"
			label="&button.details.label;"
	        oncommand="viewDetails()"
			disabled="true"/>
	<spacer/>
</hbox>

</window>
